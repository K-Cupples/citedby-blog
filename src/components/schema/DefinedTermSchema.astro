---
interface Props {
  terms: { term: string; definition: string }[];
}

const { terms } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: "Key Terms",
  hasDefinedTerm: terms.map((t) => ({
    "@type": "DefinedTerm",
    name: t.term,
    description: t.definition,
  })),
};
---

{terms.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
