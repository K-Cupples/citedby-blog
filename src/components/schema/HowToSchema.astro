---
interface Props {
  title: string;
  description: string;
  steps: { name: string; text: string }[];
}

const { title, description, steps } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: title,
  description,
  step: steps.map((step, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: step.name,
    text: step.text,
  })),
};
---

{steps.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
