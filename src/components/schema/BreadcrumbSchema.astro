---
interface Props {
  title: string;
  slug: string;
}

const { title, slug } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://citedby.co",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: "https://citedby.co/blog",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
      item: `https://citedby.co/blog/${slug}`,
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
