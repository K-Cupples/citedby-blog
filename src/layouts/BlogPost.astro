---
import Base from './Base.astro';
import ArticleSchema from '../components/schema/ArticleSchema.astro';
import FAQSchema from '../components/schema/FAQSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import HowToSchema from '../components/schema/HowToSchema.astro';
import DefinedTermSchema from '../components/schema/DefinedTermSchema.astro';
import SpeakableSchema from '../components/schema/SpeakableSchema.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    publishDate: Date;
    updatedDate?: Date;
    author: string;
    image?: { src: string; alt: string };
    keywords: string[];
    contentType: string;
    faq?: { question: string; answer: string }[];
    glossaryTerms?: { term: string; definition: string }[];
    entities?: { name: string; type: string; url?: string }[];
    howToSteps?: { name: string; text: string }[];
  };
  slug: string;
}

const { frontmatter, slug } = Astro.props;
const postUrl = `https://blog.citedby.co/${slug}`;

const readingTime = () => {
  const text = Astro.slots.has('default') ? '' : '';
  // Rough estimate: 200 words per minute
  return '5 min read';
};
---

<Base
  title={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image?.src}
  keywords={frontmatter.keywords}
>
  <Fragment slot="head">
    <ArticleSchema
      title={frontmatter.title}
      description={frontmatter.description}
      publishDate={frontmatter.publishDate}
      updatedDate={frontmatter.updatedDate}
      author={frontmatter.author}
      image={frontmatter.image}
      keywords={frontmatter.keywords}
      url={postUrl}
    />
    <BreadcrumbSchema title={frontmatter.title} slug={slug} />
    <SpeakableSchema url={postUrl} title={frontmatter.title} />
    {frontmatter.faq && frontmatter.faq.length > 0 && (
      <FAQSchema items={frontmatter.faq} />
    )}
    {frontmatter.glossaryTerms && frontmatter.glossaryTerms.length > 0 && (
      <DefinedTermSchema terms={frontmatter.glossaryTerms} />
    )}
    {frontmatter.howToSteps && frontmatter.howToSteps.length > 0 && (
      <HowToSchema
        title={frontmatter.title}
        description={frontmatter.description}
        steps={frontmatter.howToSteps}
      />
    )}
  </Fragment>

  <article class="max-w-4xl mx-auto px-6 py-12">
    <!-- Header -->
    <header class="mb-12">
      <div class="flex items-center gap-3 text-sm text-page-muted mb-4">
        <time datetime={frontmatter.publishDate.toISOString()}>
          {frontmatter.publishDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <span>·</span>
        <span>{readingTime()}</span>
        <span>·</span>
        <span class="capitalize bg-page-bg border border-page-border px-2 py-0.5 rounded text-xs font-medium">
          {frontmatter.contentType}
        </span>
      </div>

      <h1 class="post-title text-3xl sm:text-4xl font-bold leading-tight text-page-fg mb-4">
        {frontmatter.title}
      </h1>

      <p class="post-description text-lg text-page-muted leading-relaxed">
        {frontmatter.description}
      </p>

      <div class="flex items-center gap-3 mt-6 pt-6 border-t border-page-border">
        <div class="w-10 h-10 rounded-full bg-brand-green/20 flex items-center justify-center font-bold text-brand-green-dark">
          KC
        </div>
        <div>
          <p class="font-medium text-sm text-page-fg">{frontmatter.author}</p>
          <p class="text-xs text-page-muted">Founder, CitedBy</p>
        </div>
      </div>
    </header>

    {frontmatter.image && (
      <img
        src={frontmatter.image.src}
        alt={frontmatter.image.alt}
        class="w-full rounded-xl border border-page-border mb-12"
        loading="eager"
      />
    )}

    <!-- Content -->
    <div class="post-content prose prose-lg max-w-none">
      <slot />
    </div>

    <!-- FAQ Section (rendered from frontmatter) -->
    {frontmatter.faq && frontmatter.faq.length > 0 && (
      <section class="mt-16 pt-12 border-t border-page-border">
        <h2 class="text-2xl font-bold mb-8">Frequently Asked Questions</h2>
        <dl class="space-y-6">
          {frontmatter.faq.map((item) => (
            <div>
              <dt class="font-semibold text-page-fg mb-2">{item.question}</dt>
              <dd class="text-page-muted leading-relaxed">{item.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <!-- Author Bio -->
    <section class="mt-16 pt-8 border-t border-page-border">
      <div class="flex items-start gap-4">
        <div class="w-14 h-14 rounded-full bg-brand-green/20 flex items-center justify-center font-bold text-lg text-brand-green-dark flex-shrink-0">
          KC
        </div>
        <div>
          <p class="font-semibold text-page-fg">{frontmatter.author}</p>
          <p class="text-sm text-page-muted leading-relaxed mt-1">
            Founder of <a href="https://citedby.co" class="text-brand-blue hover:underline">CitedBy</a> and <a href="https://codeuntold.com" class="text-brand-blue hover:underline">Code Untold</a>. I help non-technical founders ship the right MVP, and I'm building tools to make brands visible in AI search. Technical partner at <a href="https://theanna.io" class="text-brand-blue hover:underline">Theanna</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <aside class="mt-10 p-8 bg-white rounded-xl border border-page-border text-center">
      <h3 class="text-xl font-bold mb-2">See how AI engines talk about your brand</h3>
      <p class="text-page-muted mb-6">CitedBy tracks your visibility across ChatGPT, Claude, and Perplexity. Free 7-day trial.</p>
      <a
        href="https://citedby.co/signup"
        class="inline-block bg-brand-green text-page-fg font-semibold px-6 py-3 rounded-lg hover:bg-brand-green-dark hover:text-white transition-colors"
        onclick="window.posthog && posthog.capture('blog_cta_clicked', { post: document.title, cta: 'start_free_trial' })"
      >
        Start Free Trial
      </a>
    </aside>
  </article>
</Base>
