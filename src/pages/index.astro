---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<Base
  title="Blog"
  description="Practical guides on AI visibility, answer engine optimization, and getting your brand recommended by ChatGPT, Claude, and Perplexity."
>
  <div class="max-w-4xl mx-auto px-6 py-12">
    <header class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">CitedBy Blog</h1>
      <p class="text-lg text-page-muted">
        How to get your brand recommended by AI. Data, strategies, and real results.
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="text-page-muted">Posts coming soon.</p>
    ) : (
      <div class="space-y-8">
        {posts.map((post) => (
          <article class="bg-white rounded-xl border border-page-border p-6 hover:shadow-md transition-shadow">
            <a href={`/blog/${post.slug}`} class="block group">
              <div class="flex items-center gap-3 text-sm text-page-muted mb-3">
                <time datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <span>·</span>
                <span class="capitalize bg-page-bg border border-page-border px-2 py-0.5 rounded text-xs font-medium">
                  {post.data.contentType}
                </span>
              </div>
              <h2 class="text-xl font-bold text-page-fg group-hover:text-brand-green-dark transition-colors mb-2">
                {post.data.title}
              </h2>
              <p class="text-page-muted leading-relaxed">
                {post.data.description}
              </p>
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</Base>
